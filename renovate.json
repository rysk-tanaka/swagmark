{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["npm", "github-actions", "dockerfile"],
  "labels": ["dependencies"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on saturday"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Last release 4.0.1 (2020); custom templates and markdown-it override require manual compatibility checks",
      "matchDepNames": ["widdershins"],
      "enabled": false
    }
  ]
}
