{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.claude",
      "!!coverage",
      "!!output",
      "!!examples/petstore/output",
      "!!test/tmp",
      "!!test/tmp-cli",
      "!!templates",
      "!THIRD_PARTY_LICENSES",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
